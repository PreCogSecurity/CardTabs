{
  "name": "cardtabs",
  "version": "1.1.0",
  "description": "Ultra-light jQuery plugin for very simple tabs",
  "main": "js/jquery.cardtabs.js",
  "style": "css/jquery.cardtabs.css",
  "files": [
    "js/jquery.cardtabs.js",
    "css/jquery.cardtabs.css"
  ],
  "scripts": {
    "build:demo": "node scripts/build-demo.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint js tests scripts docs/demo.js",
    "verify": "npm run lint && npm test && npm run build:demo && git diff --exit-code -- docs/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreCogSecurity/CardTabs.git"
  },
  "keywords": [
    "jquery",
    "jquery-plugin",
    "tabs",
    "cardtabs",
    "ui"
  ],
  "author": "Thomas de Roo",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "jquery": ">=1.2"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jquery": "^3.7.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "js/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 95,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  }
}
